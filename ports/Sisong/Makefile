# Sisong for Prose -- the port's build.
#
#   make            build objects/Sisong (resources and MIME attributes set)
#   make clean
#
# Works on Prose itself and as a cross build (prosepkg): the tools are named
# plainly -- g++, rc, xres, mimeset -- and the environment supplies them.
#
# Upstream's own src/Makefile is generated by its author's "makegen" from
# src/makelist.ml: one "g++ -g -c" line per file, no optimisation, no
# resources. It is left as it came; the list of sources below is the first
# list of makelist.ml, and has to follow it.

NAME     := Sisong
OBJ_DIR  ?= objects

CXX      ?= g++
RC       ?= rc
XRES     ?= xres
MIMESET  ?= mimeset

# What the code needs, whatever else is asked for:
# -fsigned-char: the code was written for x86, where plain char is signed,
# and leans on it (characters compared with -1, negative deltas kept in
# chars). On arm64 plain char is unsigned; this keeps the meaning the code
# was written and tested with. It changes no ABI: only how this program's own
# code widens a char.
# -fno-strict-aliasing: the code reads buffers through casted pointers.
PORTFLAGS := -fsigned-char -fno-strict-aliasing -std=gnu++17

# What may be chosen: make OPTIMIZE=-O0, make DEBUG= (the package is built
# without debug information), make CXXFLAGS=... for anything more. These are
# apart from PORTFLAGS so that a CXXFLAGS on the command line, which replaces
# the variable, cannot take -fsigned-char away.
OPTIMIZE ?= -O2
DEBUG    ?= -g
WARNINGS := -Wall -Wno-multichar -Wno-write-strings -Wno-unused-function \
	-Wno-unused-variable -Wno-unused-but-set-variable -Wno-sign-compare \
	-Wno-reorder -Wno-parentheses -Wno-comment -Wno-narrowing \
	-Werror=return-type
LIBS     := -lbe -ltracker

SRCS := \
	src/MainWindow.cpp src/EditArea.cpp src/EditPane.cpp src/main.cpp \
	src/edit.cpp src/edit_files.cpp src/edit_keys.cpp src/edit_cursor.cpp \
	src/UpdateLine.cpp src/selection.cpp src/edit_actions.cpp src/line.cpp \
	src/lexer.cpp src/redraw.cpp src/Templates.cpp src/InputBox.cpp \
	src/NewProject.cpp src/projects.cpp src/layout.cpp src/PopupPane.cpp \
	src/CompilePane.cpp src/SearchResults.cpp src/BuildHelpPane.cpp \
	src/menu.cpp src/draw_cursor.cpp src/LNPanel.cpp src/spacer.cpp \
	src/cmdseq.cpp src/FindBox.cpp src/DocPoint.cpp src/edit_mouse.cpp \
	src/undo.cpp src/bmatch.cpp src/tabs.cpp src/misc.cpp src/clipboard.cpp \
	src/colors.cpp src/config.cpp src/ViewTimer.cpp src/FontDrawer.cpp \
	src/SubWindow.cpp src/ColoredStringItem.cpp src/OffscreenBuffer.cpp \
	src/FunctionList.cpp src/AutoSaver.cpp src/testview.cpp src/CList.cpp \
	src/MessageView.cpp src/stats.cpp src/api_complete.cpp \
	src/lsp_client.cpp \
	src/Prefs/Prefs.cpp src/Prefs/AboutPreflet.cpp \
	src/Prefs/CheckboxPreflet.cpp src/Prefs/ColorsPreflet.cpp \
	src/Prefs/ColorItem.cpp src/Prefs/ColorView.cpp \
	src/Prefs/ShortcutsPreflet.cpp src/Prefs/StatsPreflet.cpp \
	src/FileView/IconCache.cpp src/FileView/QuickSearch.cpp \
	src/FileView/FileView.cpp src/FileView/FileItem.cpp \
	src/FileView/TitleView.cpp src/DirMenu/DirMenu.cpp \
	src/DirMenu/DirMenuItem.cpp src/ColorPicker/ColorPicker.cpp \
	src/Walter/Spinner.cpp common/stat.cpp common/misc.cpp

RDEF := prose/Sisong.rdef

# src/misc.cpp and common/misc.cpp both exist: objects keep their directory
OBJS := $(addprefix $(OBJ_DIR)/,$(SRCS:.cpp=.o))
DEPS := $(OBJS:.o=.d)
RSRC := $(OBJ_DIR)/Sisong.rsrc
APP  := $(OBJ_DIR)/$(NAME)

all: $(APP)

$(APP): $(OBJS) $(RSRC)
	$(CXX) $(LDFLAGS) -o $@ $(OBJS) $(LIBS)
	$(XRES) -o $@ $(RSRC)
	$(MIMESET) -f $@

# sources include each other's headers by paths relative to their own
# directory ("../common/basics.h"), which works from anywhere
$(OBJ_DIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(OPTIMIZE) $(DEBUG) $(CXXFLAGS) $(PORTFLAGS) $(WARNINGS) -MMD -MP -c $< -o $@

$(RSRC): $(RDEF)
	@mkdir -p $(dir $@)
	$(RC) -o $@ $<

clean:
	rm -rf $(OBJ_DIR)

.PHONY: all clean
-include $(DEPS)
