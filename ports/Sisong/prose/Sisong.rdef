/*
 * Sisong's resources. Upstream had a sisong.rdef until 2020 (signature,
 * flags, version 2.16) and no icon; this one is the port's.
 */

resource app_signature "application/x-vnd.KT-Sisong";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 2,
	middle = 16,
	minor  = 0,
	variety = B_APPV_FINAL,
	internal = 1,
	short_info = "Sisong",
	long_info = "Sisong 2.16 ©2009 Caitlin Shaw. GPL 3."
};

resource file_types message {
	"types" = "text/plain",
	"types" = "text/x-source-code",
	"types" = "text/x-makefile",
	"types" = "text/x-jamfile",
	"types" = "text/x-shellscript"
};

/* The icon: prose/Sisong.svg through tools/artwork/hviftool.py (Prose repository):
